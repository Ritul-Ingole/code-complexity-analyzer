# GitHub OAuth app credentials.
# Local development uses the _LOCAL pair; production (non-localhost APP_URL) uses the _PROD pair.
GITHUB_CLIENT_ID_LOCAL=
GITHUB_CLIENT_SECRET_LOCAL=
GITHUB_CLIENT_ID_PROD=
GITHUB_CLIENT_SECRET_PROD=

# Secret used to sign the session cookie (HMAC). Use at least 16 random characters.
# MUST be set in every environment, otherwise authentication fails.
SESSION_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LAMBDA_FUNCTION_NAME=code-complexity-analyzer
DYNAMODB_TABLE_NAME=complexity-analyses
